{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "frontend/renderer/src/env.d.ts",
    "frontend/renderer/src/**/*",
    "frontend/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // These configs exist for typechecking and editor support only — electron-vite does
    // the real building. Without this, a bare `tsc -p tsconfig.web.json` emits a .js/.jsx
    // next to every source file, and Vite resolves .jsx *before* .tsx, so the app then
    // silently runs the stale compiled copy while the .tsx on disk looks correct. That
    // cost a debugging session once already; the npm typecheck scripts pass --noEmit
    // explicitly, but nothing stopped someone running tsc by hand.
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["frontend/renderer/src/*"]
    }
  }
}
