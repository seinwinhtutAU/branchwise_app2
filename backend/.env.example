PORT=8000

# Postgres connection string — the Neon project's pooled endpoint (Connect button in the
# Neon console), which already carries ?sslmode=require. Leave as-is for a local SQLite
# file during early development.
DATABASE_URL=sqlite:///./app.db

# Neon Auth (managed Better Auth), from the Neon console under branch > Auth. The backend
# proxies sign-in to it and verifies its JWTs against the JWKS URL — see
# docs/auth-and-accounts.md. JWKS defaults to <base>/.well-known/jwks.json when blank.
NEON_AUTH_BASE_URL=https://YOUR_ENDPOINT.neonauth.YOUR_REGION.aws.neon.tech/YOUR_DB/auth
NEON_AUTH_JWKS_URL=

# Powers the retail chatbot (POST /api/chat). Leave blank to disable it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
