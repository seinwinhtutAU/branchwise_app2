PORT=8000

# Postgres connection string (use your Supabase project's connection string here).
# Leave as-is to use a local SQLite file for early development.
DATABASE_URL=sqlite:///./app.db

# Supabase project settings > API (used to verify tokens via the project's JWKS endpoint)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Powers the retail chatbot (POST /api/chat). Leave blank to disable it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
