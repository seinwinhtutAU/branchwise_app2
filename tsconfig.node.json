{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "frontend/main/**/*",
    "frontend/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    // Typecheck-only, same as tsconfig.web.json — see the note there for why emitting
    // next to the sources is actively harmful rather than merely untidy.
    "noEmit": true,
    "types": ["electron-vite/node"]
  }
}
